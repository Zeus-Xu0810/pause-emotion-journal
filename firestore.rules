rules_version = '2';
// 数据模型：users/{uid}/entries/{id} 为私密日记，careSessions/{id} 为私密练习记录。
// 日记字段：mood(整数1—5)、feelings/contexts(固定词表且最多8项)、note(0—2000字)、
// occurredAt(发生时间戳)、createdAt(不可变服务端时间戳)、updatedAt(服务端时间戳)、revision(正整数版本)。
// 练习字段：type(四种类型)、title(1—80字)、durationSeconds(1—3600整数)、beforeMood(null或1—5)、
// feedback(三种反馈)、entryId(null或本人日记ID)、createdAt(不可变服务端时间戳)。
service cloud.firestore {
  match /databases/{database}/documents {
    // 仅当前已验证账号拥有自己的路径，父级用户文档与其他路径默认关闭。
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid && request.auth.token.email_verified == true;
    }
    function validMood(value) { return value is int && value >= 1 && value <= 5; }
    function validFeelings(value) {
      return value is list && value.size() <= 8 && value.toSet().size() == value.size()
        && value.hasOnly(['焦虑', '疲惫', '烦躁', '委屈', '孤独', '平静', '满足', '期待']);
    }
    function validContexts(value) {
      return value is list && value.size() <= 8 && value.toSet().size() == value.size()
        && value.hasOnly(['学业', '工作', '关系', '社交', '睡眠', '身体', '独处', '日常小事']);
    }
    // 同一验证函数同时用于创建和更新，防止写入后再绕过字段限制。
    function isValidEntry(data) {
      let keys = ['mood', 'feelings', 'contexts', 'note', 'occurredAt', 'createdAt', 'updatedAt', 'revision'];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys)
        && validMood(data.mood) && validFeelings(data.feelings) && validContexts(data.contexts)
        && data.note is string && data.note.size() <= 2000
        && data.occurredAt is timestamp && data.occurredAt >= timestamp.date(2000, 1, 1)
        && data.occurredAt <= request.time + duration.value(1, 'h')
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time && data.revision is int && data.revision >= 1;
    }
    function isValidCareSession(data, uid) {
      let keys = ['type', 'title', 'durationSeconds', 'beforeMood', 'feedback', 'entryId', 'createdAt'];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys)
        && data.type in ['breathing', 'mindfulness', 'music', 'movement']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.durationSeconds is int && data.durationSeconds >= 1 && data.durationSeconds <= 3600
        && (data.beforeMood == null || validMood(data.beforeMood))
        && data.feedback in ['better', 'same', 'unsuitable']
        && (data.entryId == null || (data.entryId is string && data.entryId.size() >= 1 && data.entryId.size() <= 128
          && data.entryId.matches('^[A-Za-z0-9_-]+$')
          && exists(/databases/$(database)/documents/users/$(uid)/entries/$(data.entryId))))
        && data.createdAt is timestamp && data.createdAt == request.time;
    }
    match /users/{uid}/entries/{entryId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidEntry(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.revision == 1;
      allow update: if isOwner(uid) && isValidEntry(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if isOwner(uid);
    }
    // 完成反馈是不可变事件，避免重复覆盖历史；需要移除时只允许本人单条删除。
    match /users/{uid}/careSessions/{sessionId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidCareSession(request.resource.data, uid);
      allow update: if false;
      allow delete: if isOwner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
